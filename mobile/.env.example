# Copia a .env para apuntar la app al Google Apps Script Web App atado a la
# planilla (ver ../apps-script/README.md). Sin estas dos variables, la app usa
# un cliente simulado (MockSheetsClient) y no intenta hablar con Google — así
# se puede desarrollar sin ninguna credencial.

EXPO_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_ID_DE_DESPLIEGUE/exec
EXPO_PUBLIC_API_KEY=la-misma-clave-que-pusiste-en-guardarApiKey()
