# Copia a .env para apuntar la app al backend real de Sheets (ver ../server/README.md).
# Sin estas dos variables, la app usa un cliente simulado (MockSheetsClient)
# y no intenta hablar con ningún backend — así se puede desarrollar sin
# credenciales de Google Cloud.

EXPO_PUBLIC_API_BASE_URL=https://tu-deploy.vercel.app
EXPO_PUBLIC_API_KEY=el-mismo-valor-que-APP_API_KEY-en-el-server
