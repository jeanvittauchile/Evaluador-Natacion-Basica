# Copia este archivo a .env (para `vercel dev`) y/o configura las mismas
# variables como Environment Variables del proyecto en el dashboard de Vercel.
# Nunca subas el .env real — .gitignore ya lo excluye.

# Google Cloud Console → credenciales OAuth de tipo "Web" (ver README raíz
# §"Configuración OAuth2"). Redirect URI autorizado:
#   https://<tu-deploy>.vercel.app/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Se obtienen visitando /api/oauth/start una vez, con la cuenta de Google que
# debe recibir la planilla. La página de /api/oauth/callback los muestra.
GOOGLE_REFRESH_TOKEN=
GOOGLE_SPREADSHEET_ID=

# Clave compartida que la app móvil manda en el header x-api-key. Genérala tú
# mismo (ej. `openssl rand -hex 32`) — no tiene por qué venir de Google.
APP_API_KEY=
